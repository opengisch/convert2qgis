{
  "$ref": "#/definitions/Json2qgisSchema",
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "definitions": {
    "CustomProperties": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "type": "object"
    },
    "Field": {
      "additionalProperties": false,
      "dependentRequired": {
        "constraint_expression": [
          "constraint_expression_strength",
          "constraint_expression_description"
        ],
        "constraint_expression_description": [
          "constraint_expression",
          "constraint_expression_strength"
        ],
        "constraint_expression_strength": [
          "constraint_expression",
          "constraint_expression_description"
        ],
        "is_not_null": [
          "is_not_null_strength"
        ],
        "is_not_null_strength": [
          "is_not_null"
        ],
        "is_unique": [
          "is_unique_strength"
        ],
        "is_unique_strength": [
          "is_unique"
        ]
      },
      "properties": {
        "alias": {
          "type": "string"
        },
        "alias_expression": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "constraint_expression": {
          "type": "string"
        },
        "constraint_expression_description": {
          "type": "string"
        },
        "constraint_expression_strength": {
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "default_value": {
          "type": "string"
        },
        "field_id": {
          "type": "string"
        },
        "is_not_null": {
          "type": "boolean"
        },
        "is_not_null_strength": {
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "is_unique": {
          "type": "boolean"
        },
        "is_unique_strength": {
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "length": {
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "precision": {
          "maximum": 15,
          "minimum": 0,
          "type": "integer"
        },
        "set_default_value_on_update": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "real",
            "boolean",
            "datetime",
            "date",
            "time"
          ],
          "type": "string"
        },
        "widget_config": {
          "$ref": "#/definitions/WidgetConfig"
        },
        "widget_type": {
          "enum": [
            "Hidden",
            "Color",
            "TextEdit",
            "Range",
            "DateTime",
            "ExternalResource",
            "CheckBox",
            "ValueMap",
            "ValueRelation"
          ],
          "type": "string"
        }
      },
      "required": [
        "alias",
        "comment",
        "length",
        "name",
        "precision",
        "set_default_value_on_update",
        "type",
        "widget_config",
        "widget_type"
      ],
      "title": "Field",
      "type": "object"
    },
    "FormConfig": {
      "items": {
        "$ref": "#/definitions/FormItemContainer"
      },
      "type": "array"
    },
    "VisualStyle": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "theme": {
              "type": [
                "null",
                "string"
              ]
            },
            "qml_filename": {
              "type": "string",
              "description": "A path to a QGIS Layer Style file (.qlr) that defines the visual style for the layer. The path can be absolute or relative to the JSON file."
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "theme": {
              "type": [
                "null",
                "string"
              ]
            },
            "qml_content": {
              "type": "string",
              "description": "The content of a QGIS Layer Style file (.qlr) that defines the visual style for the layer."
            }
          }
        }
      ]
    },
    "FormItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/FormItemContainer"
        },
        {
          "$ref": "#/definitions/FormItemField"
        },
        {
          "$ref": "#/definitions/FormItemText"
        }
      ],
      "title": "Item",
      "type": "object"
    },
    "FormItemContainer": {
      "additionalProperties": false,
      "properties": {
        "background_color": {
          "type": "string"
        },
        "column_count": {
          "type": "integer"
        },
        "is_collapsed": {
          "type": "boolean"
        },
        "item_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "tab",
            "group_box",
            "row"
          ],
          "type": "string"
        },
        "visibility_expression": {
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/definitions/FormItem"
          },
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "type",
        "label"
      ],
      "title": "Form Item Container",
      "type": "object"
    },
    "FormItemField": {
      "additionalProperties": false,
      "properties": {
        "field_name": {
          "minLength": 1,
          "type": "string"
        },
        "is_label_on_top": {
          "type": "boolean"
        },
        "is_read_only": {
          "type": "boolean"
        },
        "item_id": {
          "minLength": 1,
          "type": "string"
        },
        "show_label": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "field",
            "relation"
          ],
          "type": "string"
        },
        "visibility_expression": {
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "type",
        "field_name"
      ],
      "title": "Form Item Field",
      "type": "object"
    },
    "FormItemText": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string"
        },
        "show_label": {
          "type": "boolean"
        },
        "is_markdown": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "text"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "visibility_expression": {
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "type",
        "label"
      ],
      "title": "Form Item Text",
      "type": "object"
    },
    "Json2qgisSchema": {
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "items": {
            "$ref": "#/definitions/DatasetGroup"
          },
          "type": "array"
        },
        "legend_tree": {
          "$ref": "#/definitions/LegendTreeGroup"
        },
        "polymorphic_relations": {
          "items": {
            "$ref": "#/definitions/PolymorphicRelation"
          },
          "type": "array"
        },
        "project": {
          "$ref": "#/definitions/Project"
        },
        "relations": {
          "items": {
            "$ref": "#/definitions/Relation"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "datasets",
        "project",
        "relations",
        "polymorphic_relations",
        "legend_tree",
        "version"
      ],
      "title": "Empty",
      "type": "object"
    },
    "DatasetGroup": {
      "additionalProperties": false,
      "properties": {
        "raster_datasets": {
          "items": {
            "$ref": "#/definitions/RasterDataset"
          },
          "type": "array"
        },
        "vector_datasets": {
          "items": {
            "$ref": "#/definitions/VectorDataset"
          },
          "type": "array"
        }
      },
      "required": [
        "vector_datasets",
        "raster_datasets"
      ],
      "type": "object"
    },
    "VectorDataset": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "type": "string"
        },
        "custom_properties": {
          "$ref": "#/definitions/CustomProperties"
        },
        "data": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "datasource": {
          "type": "object",
          "description": "An existing layer to load instead of creating a new one. Its properties depend on `datasource_format`: `OgrDatasource` for `gpkg` and `ogr`, `PostgresDatasource` for `postgres`, `WfsDatasource` for `wfs` and `OapifDatasource` for `oapif`. `geometry_type` is then ignored as the data provider decides it, `crs` is still set on the layer, and `data` is not supported. Required for the `ogr`, `postgres`, `wfs` and `oapif` formats, which only load existing layers, and not supported for `memory`."
        },
        "datasource_format": {
          "enum": [
            "gpkg",
            "memory",
            "ogr",
            "postgres",
            "oapif",
            "wfs"
          ],
          "type": "string"
        },
        "display_expression": {
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/definitions/Field"
          },
          "type": "array"
        },
        "virtual_fields": {
          "items": {
            "$ref": "#/definitions/Field"
          },
          "type": "array"
        },
        "foreign_keys": {
          "items": {},
          "type": "array"
        },
        "form_config": {
          "$ref": "#/definitions/FormConfig"
        },
        "visual_styles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VisualStyle"
          }
        },
        "geometry_type": {
          "enum": [
            "Point",
            "LineString",
            "Polygon",
            "MultiPoint",
            "MultiLineString",
            "MultiPolygon",
            "NoGeometry"
          ],
          "type": "string"
        },
        "indices": {
          "items": {},
          "type": "array"
        },
        "is_identifiable": {
          "type": "boolean"
        },
        "is_private": {
          "type": "boolean"
        },
        "is_read_only": {
          "type": "boolean"
        },
        "is_removable": {
          "type": "boolean"
        },
        "is_searchable": {
          "type": "boolean"
        },
        "layer_id": {
          "type": "string"
        },
        "layer_type": {
          "type": "string",
          "const": "vector"
        },
        "name": {
          "type": "string"
        },
        "primary_key": {
          "type": "string"
        }
      },
      "required": [
        "foreign_keys",
        "indices",
        "primary_key",
        "crs",
        "datasource_format",
        "fields",
        "form_config",
        "geometry_type",
        "name",
        "layer_type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "geometry_type": {
                "const": "NoGeometry"
              }
            },
            "required": [
              "geometry_type"
            ]
          },
          "then": {
            "properties": {
              "crs": {
                "pattern": "^(EPSG:\\d+)?$"
              }
            }
          },
          "else": {
            "properties": {
              "crs": {
                "pattern": "^EPSG:\\d+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "enum": [
                  "gpkg",
                  "ogr"
                ]
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "properties": {
              "datasource": {
                "$ref": "#/definitions/OgrDatasource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "const": "postgres"
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "properties": {
              "datasource": {
                "$ref": "#/definitions/PostgresDatasource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "const": "wfs"
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "properties": {
              "datasource": {
                "$ref": "#/definitions/WfsDatasource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "const": "oapif"
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "properties": {
              "datasource": {
                "$ref": "#/definitions/OapifDatasource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "const": "memory"
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "not": {
              "required": [
                "datasource"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "enum": [
                  "ogr",
                  "postgres",
                  "oapif",
                  "wfs"
                ]
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "required": [
              "datasource"
            ]
          }
        }
      ],
      "title": "Vector Dataset",
      "type": "object"
    },
    "OgrDatasource": {
      "title": "OGR Datasource",
      "description": "An existing layer in a file readable by OGR, e.g. a GeoPackage, a Shapefile or a GeoJSON file.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "The path to the file, e.g. `/path/to/data.gpkg`."
        },
        "layer_name": {
          "type": "string",
          "description": "The name of the layer in the file, e.g. `roads`. If not set, the first layer of the file is loaded."
        }
      },
      "required": [
        "path"
      ]
    },
    "PostgresDatasource": {
      "title": "PostgreSQL Datasource",
      "description": "An existing table or view in a PostgreSQL database. The connection is set either with a `service` from the `pg_service.conf` file, or with `host`, `port` and `dbname`. Prefer `service` or `authcfg` over `username` and `password`, as these are stored as plain text in the project file.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1,
          "description": "The name of the table or view, e.g. `roads`."
        },
        "schema": {
          "type": "string",
          "description": "The schema of the table or view, e.g. `public`."
        },
        "geometry_column": {
          "type": "string",
          "description": "The name of the geometry column, e.g. `geom`. Not set for tables without geometry."
        },
        "key_column": {
          "type": "string",
          "description": "The name of the column that uniquely identifies the features, e.g. `id`. QGIS detects the primary key of tables, so it is mostly needed for views."
        },
        "service": {
          "type": "string",
          "description": "The name of a service in the `pg_service.conf` file, e.g. `my_db`."
        },
        "host": {
          "type": "string",
          "description": "The database server host name, e.g. `db.example.com`."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "The database server port, e.g. `5432`."
        },
        "dbname": {
          "type": "string",
          "description": "The name of the database, e.g. `gis`."
        },
        "username": {
          "type": "string",
          "description": "The database user name."
        },
        "password": {
          "type": "string",
          "description": "The database user password, stored as plain text in the project file."
        },
        "authcfg": {
          "type": "string",
          "description": "The ID of a QGIS authentication configuration holding the credentials, e.g. `abc1234`."
        },
        "sslmode": {
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ],
          "type": "string",
          "description": "The SSL mode of the connection, `prefer` if not set."
        }
      },
      "required": [
        "table"
      ]
    },
    "WfsDatasource": {
      "title": "WFS Datasource",
      "description": "A feature type of an OGC Web Feature Service (WFS).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "The URL of the service, e.g. `https://example.com/wfs`."
        },
        "type_name": {
          "type": "string",
          "minLength": 1,
          "description": "The name of the feature type, e.g. `ns:roads`."
        },
        "version": {
          "enum": [
            "auto",
            "1.0.0",
            "1.1.0",
            "2.0.0"
          ],
          "type": "string",
          "description": "The WFS version, detected from the service if not set or `auto`."
        },
        "authcfg": {
          "type": "string",
          "description": "The ID of a QGIS authentication configuration holding the credentials, e.g. `abc1234`."
        }
      },
      "required": [
        "url",
        "type_name"
      ]
    },
    "OapifDatasource": {
      "title": "OGC API Features Datasource",
      "description": "A collection of an OGC API - Features service.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "The URL of the service landing page, e.g. `https://example.com/ogcapi`."
        },
        "collection": {
          "type": "string",
          "minLength": 1,
          "description": "The ID of the collection, e.g. `roads`."
        },
        "authcfg": {
          "type": "string",
          "description": "The ID of a QGIS authentication configuration holding the credentials, e.g. `abc1234`."
        }
      },
      "required": [
        "url",
        "collection"
      ]
    },
    "RasterDataset": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "pattern": "^EPSG:\\d+$",
          "type": "string"
        },
        "custom_properties": {
          "$ref": "#/definitions/CustomProperties"
        },
        "datasource": {
          "type": "string"
        },
        "datasource_format": {
          "enum": [
            "wms"
          ],
          "type": "string"
        },
        "is_identifiable": {
          "type": "boolean"
        },
        "is_private": {
          "type": "boolean"
        },
        "is_read_only": {
          "type": "boolean"
        },
        "is_removable": {
          "type": "boolean"
        },
        "is_searchable": {
          "type": "boolean"
        },
        "layer_id": {
          "type": "string"
        },
        "layer_type": {
          "type": "string",
          "const": "raster"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "crs",
        "datasource",
        "datasource_format",
        "name",
        "layer_type"
      ],
      "title": "Raster Dataset",
      "type": "object"
    },
    "LegendTreeItemBase": {
      "properties": {
        "item_id": {
          "type": "string"
        },
        "is_checked": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "legend_item_type": {
          "enum": [
            "group",
            "layer"
          ],
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "name",
        "legend_item_type"
      ],
      "title": "Child",
      "type": "object"
    },
    "LegendTreeLayer": {
      "allOf": [
        {
          "$ref": "#/definitions/LegendTreeItemBase"
        },
        {
          "type": "object",
          "properties": {
            "layer_id": {
              "type": "string"
            },
            "legend_item_type": {
              "type": "string",
              "const": "layer"
            }
          },
          "required": [
            "layer_id"
          ]
        }
      ]
    },
    "LegendTreeGroup": {
      "allOf": [
        {
          "$ref": "#/definitions/LegendTreeItemBase"
        },
        {
          "type": "object",
          "properties": {
            "is_mutually_exclusive": {
              "type": "boolean"
            },
            "mutually_exclusive_child_index": {
              "minimum": -1,
              "type": "integer"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/LegendTreeItem"
              }
            },
            "legend_item_type": {
              "type": "string",
              "const": "group"
            }
          },
          "required": [
            "children"
          ]
        }
      ]
    },
    "LegendTreeItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/LegendTreeGroup"
        },
        {
          "$ref": "#/definitions/LegendTreeLayer"
        }
      ],
      "unevaluatedProperties": false
    },
    "PolymorphicRelation": {
      "additionalProperties": false,
      "properties": {
        "field_pairs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from_field": {
                "type": "string"
              },
              "to_field": {
                "type": "string"
              }
            },
            "required": [
              "from_field",
              "to_field"
            ],
            "title": "FieldPair",
            "type": "object"
          },
          "type": "array"
        },
        "from_layer_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "relation_id": {
          "type": "string"
        },
        "strength": {
          "enum": [
            "association",
            "composition"
          ],
          "type": "string"
        },
        "to_layer_expression": {
          "type": "string"
        },
        "to_layer_field": {
          "type": "string"
        },
        "to_layer_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "name",
        "from_layer_id",
        "to_layer_field",
        "to_layer_expression",
        "to_layer_ids"
      ],
      "title": "Relation",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "custom_properties": {
          "$ref": "#/definitions/CustomProperties"
        },
        "title": {
          "type": "string"
        },
        "crs": {
          "type": "string",
          "pattern": "^EPSG:\\d+$"
